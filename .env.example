# =============================================================================
# ShopSphere - environment template
# =============================================================================
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Every value below has a working default in code, so an empty `.env` still
# boots locally. The variables are listed so that each knob is discoverable.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=local                 # local | test | ci | production
DEBUG=false
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # json (machine readable) | console (local dev)

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Docker Compose overrides the host to `postgres`; localhost is for bare-metal runs.
DATABASE_URL=postgresql+psycopg://shopsphere:shopsphere@localhost:5432/shopsphere
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The application refuses to start in ENVIRONMENT=production while this is the placeholder.
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12                  # lower to 4 in CI to keep auth-heavy suites fast
PASSWORD_MIN_LENGTH=8

# -----------------------------------------------------------------------------
# CORS (comma separated)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Commerce rules - the backend is the only authority on money
# -----------------------------------------------------------------------------
CURRENCY=USD
TAX_RATE=0.08                     # fraction, not a percentage
SHIPPING_FLAT_FEE=9.99
FREE_SHIPPING_THRESHOLD=100.00
MAX_ITEM_QUANTITY=99
MAX_CART_ITEMS=50

# -----------------------------------------------------------------------------
# Mock payment provider
# -----------------------------------------------------------------------------
PAYMENT_SERVICE_URL=http://127.0.0.1:9100
PAYMENT_TIMEOUT_SECONDS=8.0
# Failure simulation. `card` lets the card number decide the outcome, which is
# what test suites use. Any other value forces that outcome for EVERY charge -
# useful for chaos runs and for the demo in docs/failure-simulation.md.
#   card | success | declined | timeout | server_error
PAYMENT_MODE=card

# Payment mock service's own knobs
PAYMENT_MOCK_PORT=9100
PAYMENT_MOCK_TIMEOUT_DELAY_SECONDS=30   # how long the "timeout" card stalls for
PAYMENT_MOCK_LATENCY_MS=0               # baseline artificial latency on every charge

# -----------------------------------------------------------------------------
# Seed data - demo accounts created by `make seed`
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@shopsphere.test
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_CUSTOMER_PASSWORD=CustomerPass123!

# =============================================================================
# Test platform (tests/ - read by tests/configuration/settings.py)
# =============================================================================
API_BASE_URL=http://127.0.0.1:8000
UI_BASE_URL=http://127.0.0.1:5173
PAYMENT_MOCK_URL=http://127.0.0.1:9100

# Tests connect to PostgreSQL directly to assert on persisted state.
# Credentials come from the environment - never hardcode them in test code.
TEST_DATABASE_URL=postgresql://shopsphere:shopsphere@localhost:5432/shopsphere

# Must match the backend's SECRET_KEY so security tests can mint expired /
# tampered tokens deterministically instead of sleeping until expiry.
TEST_JWT_SECRET=dev-only-insecure-secret-change-me

TEST_ADMIN_EMAIL=admin@shopsphere.test
TEST_ADMIN_PASSWORD=AdminPass123!
TEST_CUSTOMER_EMAIL=alice@shopsphere.test
TEST_CUSTOMER_PASSWORD=CustomerPass123!

API_TIMEOUT_SECONDS=30
UI_TIMEOUT_MS=15000
# Response-time budget asserted by API tests. Generous on purpose: it is a
# regression guard against pathological queries, not a performance benchmark.
API_SLA_MS=2000

# -----------------------------------------------------------------------------
# Playwright
# -----------------------------------------------------------------------------
HEADLESS=true
BROWSER=chromium                  # chromium | firefox | webkit
SLOW_MO_MS=0
CAPTURE_VIDEO=retain-on-failure   # off | on | retain-on-failure
CAPTURE_TRACE=retain-on-failure   # off | on | retain-on-failure
